# Permite servir os arquivos enviados normalmente, mas impede que qualquer
# arquivo seja executado como script PHP (proteção contra upload malicioso).
<FilesMatch "\.(php|php\d?|phtml|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
