DATABASE_URL="postgresql://user:password@localhost:5432/habitou?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_COOKIE_NAME="habitou_session"

APP_URL="http://localhost:3000"
NODE_ENV="development"

# SMTP (recuperação de senha, contato, notificações)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Habitou Imóveis <no-reply@habitou.com.br>"

# Protege a rota /api/cron/vrsync contra chamadas públicas não autorizadas
CRON_SECRET="replace-with-a-long-random-string"
